<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<meta http-equiv="x-ua-compatible" content="ie=edge">
<title>Özbek yozuvlari — konverter</title>
<hta:application id="ozb" applicationname="OzbekAlifbo2026" border="thick" maximizebutton="yes" singleinstance="yes" scroll="no" icon="mshta.exe">
<style>
body{margin:0;padding:14px 18px;font-family:"Segoe UI",Tahoma,Arial,sans-serif;font-size:14px;background:#f4f4f4;color:#1a1a1a}
h1{margin:0 0 4px 0;font-size:20px}
.sub{margin:0 0 12px 0;color:#555}
.row{width:100%}
.col{width:49%;float:left}
.col2{width:49%;float:right}
label{display:block;font-weight:bold;margin-bottom:4px}
textarea{width:100%;height:300px;box-sizing:border-box;padding:8px;font-size:15px;font-family:"Segoe UI",Tahoma,Arial,sans-serif;border:1px solid #8a8a8a}
#chiq{background:#fff7ef;border-color:#C2410C}
.btns{clear:both;padding-top:12px}
button{font-size:14px;padding:8px 14px;margin-right:8px;cursor:pointer;border:1px solid #8a8a8a;background:#fff}
.tanlangan{background:#C2410C;color:#fff;border-color:#C2410C;font-weight:bold}
#holat{margin-top:10px;color:#1D4ED8;font-weight:bold;height:20px}
.yord{margin-top:10px;padding:10px 12px;background:#fff;border:1px solid #c9c9c9;font-size:13px;line-height:1.45}
.yord b{color:#1a1a1a}
</style>
<script type="text/javascript">
// Ozbek alifbo 2026 konverteri (ES3 - Internet Explorer / HTA uchun ham ishlaydi)
var OZB = (function () {
  var AP = "'`‘’ʻʼ´";
  var TUTUQ = "ʼ";
  var ISTISNO = "|chrome|chat|check|chip|cheese|chess|chicken|chief|child|choice|church|chart|channel|chapter|" +
    "shop|show|shift|share|shell|shot|ship|shirt|shoe|short|should|shut|sheet|shelf|shine|" +
    "flash|push|cash|crash|fresh|english|wash|finish|match|search|touch|teacher|school|machine|" +
    "mechanic|technology|orchestra|chemistry|character|schedule|shampoo|chips|ketchup|";
  var MAP = {};
  var pairs = [
    [0x430, "a"], [0x431, "b"], [0x432, "v"], [0x433, "g"], [0x493, "ğ"], [0x434, "d"], [0x436, "j"],
    [0x437, "z"], [0x438, "i"], [0x439, "y"], [0x43A, "k"], [0x49B, "q"], [0x43B, "l"], [0x43C, "m"],
    [0x43D, "n"], [0x43E, "o"], [0x43F, "p"], [0x440, "r"], [0x442, "t"], [0x443, "u"], [0x45E, "ö"],
    [0x444, "f"], [0x445, "x"], [0x4B3, "h"], [0x447, "ç"], [0x448, "ş"], [0x449, "ş"],
    [0x44B, "i"], [0x44D, "e"]
  ];
  for (var p = 0; p < pairs.length; p++) MAP[pairs[p][0]] = pairs[p][1];

  function isAp(c) { return c !== "" && AP.indexOf(c) >= 0; }
  function isLet(c) {
    if (!c) return false;
    var k = c.charCodeAt(0);
    return (k >= 65 && k <= 90) || (k >= 97 && k <= 122) || (k >= 0xC0 && k <= 0x24F) || (k >= 0x400 && k <= 0x4FF);
  }
  function lowK(k) {
    if (k >= 0x410 && k <= 0x42F) return k + 0x20;
    if (k === 0x401) return 0x451;
    if (k === 0x40E) return 0x45E;
    if (k === 0x492) return 0x493;
    if (k === 0x49A) return 0x49B;
    if (k === 0x4B2) return 0x4B3;
    return k;
  }
  function isUp(c) {
    if (!c) return false;
    var k = c.charCodeAt(0);
    if (k >= 65 && k <= 90) return true;
    if (k >= 0x410 && k <= 0x42F) return true;
    return k === 0x401 || k === 0x40E || k === 0x492 || k === 0x49A || k === 0x4B2 ||
      k === 0xD6 || k === 0x11E || k === 0x15E || k === 0xC7;
  }
  function isVow(c) {
    if (!c) return false;
    var k = lowK(c.charCodeAt(0));
    return k === 0x430 || k === 0x435 || k === 0x451 || k === 0x438 || k === 0x43E ||
      k === 0x443 || k === 0x45E || k === 0x44D || k === 0x44E || k === 0x44F;
  }
  function lk(c) { return c ? lowK(c.charCodeAt(0)) : 0; }
  function cap(s, up, nu) {
    if (!up || !s) return s;
    if (nu || s.length === 1) return s.toUpperCase();
    return s.charAt(0).toUpperCase() + s.substring(1);
  }
  function hasCyr(t) {
    for (var i = 0; i < t.length; i++) { var k = t.charCodeAt(i); if (k >= 0x400 && k <= 0x4FF) return true; }
    return false;
  }
  function kirill(t) {
    var r = "", n = t.length;
    for (var i = 0; i < n; i++) {
      var c = t.charAt(i), pv = i > 0 ? t.charAt(i - 1) : "", nx = i < n - 1 ? t.charAt(i + 1) : "";
      var up = isUp(c), nu = isUp(nx), k = lowK(c.charCodeAt(0)), o;
      if (k === 0x435) o = cap((!isLet(pv) || isVow(pv) || lk(pv) === 0x44A || lk(pv) === 0x44C) ? "ye" : "e", up, nu);
      else if (k === 0x451) o = cap("yo", up, nu);
      else if (k === 0x44E) o = cap("yu", up, nu);
      else if (k === 0x44F) o = cap("ya", up, nu);
      else if (k === 0x446) o = cap(isVow(pv) ? "ts" : "s", up, nu);
      else if (k === 0x44A) o = TUTUQ;
      else if (k === 0x44C) o = lk(nx) === 0x43E ? cap("y", up, nu) : "";
      else if (k === 0x441) o = cap("s", up, nu) + (lk(nx) === 0x4B3 ? TUTUQ : "");
      else { o = MAP[k]; o = o ? cap(o, up, nu) : c; }
      r += o;
    }
    return r;
  }
  function himoya(t) {
    var L = t.toLowerCase(), w = "";
    if (L.indexOf("@") >= 0 || L.indexOf("://") >= 0 || L.indexOf("www.") >= 0 || L.indexOf("w") >= 0) return true;
    for (var i = 0; i < L.length; i++) {
      var ch = L.charAt(i), nx = L.charAt(i + 1);
      if (ch === "c" && nx !== "h") return true;
      if (ch === "." && i > 0 && nx >= "a" && nx <= "z") return true;
      if (ch >= "a" && ch <= "z") w += ch;
    }
    return w !== "" && ISTISNO.indexOf("|" + w + "|") >= 0;
  }
  var OG = { "o": "ö", "O": "Ö", "g": "ğ", "G": "Ğ" };
  var SC = { "s": "ş", "S": "Ş", "c": "ç", "C": "Ç" };
  function eski(t) {
    var r = "", i = 0, n = t.length;
    while (i < n) {
      var c = t.charAt(i), nx = i < n - 1 ? t.charAt(i + 1) : "";
      if (isAp(nx) && OG[c]) { r += OG[c]; i += 2; }
      else if ((nx === "h" || nx === "H") && SC[c]) { r += SC[c]; i += 2; }
      else if (isAp(c) && i > 0 && i < n - 1) { r += (isLet(t.charAt(i - 1)) && isLet(nx)) ? TUTUQ : c; i++; }
      else { r += c; i++; }
    }
    return r;
  }
  function token(t) {
    if (hasCyr(t)) t = kirill(t);
    if (!himoya(t)) t = eski(t);
    return t;
  }
  function ogir(s) {
    var res = "", tok = "";
    for (var i = 0; i < s.length; i++) {
      var ch = s.charAt(i);
      if (ch === " " || ch === "\t" || ch === "\n" || ch === "\r" || ch === " " || ch === "\u000B") {
        if (tok) { res += token(tok); tok = ""; }
        res += ch;
      } else tok += ch;
    }
    if (tok) res += token(tok);
    return res;
  }

  var LATCYR = {"a":0x430,"b":0x431,"d":0x434,"f":0x444,"g":0x433,"h":0x4B3,"i":0x438,"j":0x436,"k":0x43A,"l":0x43B,
    "m":0x43C,"n":0x43D,"o":0x43E,"p":0x43F,"q":0x49B,"r":0x440,"s":0x441,"t":0x442,"u":0x443,"v":0x432,"x":0x445,
    "y":0x439,"z":0x437,"ö":0x45E,"ğ":0x493,"ş":0x448,"ç":0x447};
  function upCyr(k) {
    if (k >= 0x430 && k <= 0x44F) return k - 0x20;
    if (k === 0x451) return 0x401; if (k === 0x45E) return 0x40E; if (k === 0x493) return 0x492;
    if (k === 0x49B) return 0x49A; if (k === 0x4B3) return 0x4B2; return k;
  }
  function cy(k, up) { return String.fromCharCode(up ? upCyr(k) : k); }
  function latVow(c) { return c !== "" && "aeiouAEIOUöÖ".indexOf(c) >= 0; }
  function to1995(t) {
    var r = "", n = t.length;
    for (var i = 0; i < n; i++) {
      var c = t.charAt(i), nx = i < n - 1 ? t.charAt(i + 1) : "", pv = i > 0 ? t.charAt(i - 1) : "";
      var kat = isUp(nx) || (!isLet(nx) && isUp(pv));
      if (c === "ö") r += "oʻ"; else if (c === "Ö") r += "Oʻ";
      else if (c === "ğ") r += "gʻ"; else if (c === "Ğ") r += "Gʻ";
      else if (c === "ş") r += "sh"; else if (c === "Ş") r += kat ? "SH" : "Sh";
      else if (c === "ç") r += "ch"; else if (c === "Ç") r += kat ? "CH" : "Ch";
      else r += c;
    }
    return r;
  }
  function toKirill(t) {
    var r = "", i = 0, n = t.length;
    while (i < n) {
      var c = t.charAt(i), lc = c.toLowerCase(), up = isUp(c), nx = t.charAt(i + 1), ln = nx.toLowerCase();
      var n2 = t.charAt(i + 2), pv = i > 0 ? t.charAt(i - 1) : "", k;
      if (lc === "y" && (ln === "e" || ln === "o" || ln === "u" || ln === "a")) {
        k = ln === "e" ? 0x435 : ln === "o" ? 0x451 : ln === "u" ? 0x44E : 0x44F;
        r += cy(k, up); i += 2;
      } else if (lc === "s" && nx === TUTUQ && n2.toLowerCase() === "h") {
        r += cy(0x441, up) + cy(0x4B3, isUp(n2)); i += 3;
      } else if (lc === "e") {
        r += cy((!isLet(pv) || latVow(pv)) ? 0x44D : 0x435, up); i++;
      } else if (c === TUTUQ) {
        r += (isLet(pv) && isLet(nx)) ? cy(0x44A, isUp(pv) && isUp(nx)) : c; i++;
      } else {
        if (lc === "c") k = (ln === "e" || ln === "i" || ln === "y") ? 0x441 : 0x43A;
        else if (lc === "w") k = 0x432;
        else k = LATCYR[lc];
        r += k ? cy(k, up) : c; i++;
      }
    }
    return r;
  }
  function token3(t, m) {
    var cyr = hasCyr(t);
    if (m === 3 && cyr) return t;
    t = cyr ? kirill(t) : eski(t);
    return m === 2 ? to1995(t) : (m === 3 ? toKirill(t) : t);
  }
  function ogir3(s, m) {
    var res = "", tok = "";
    for (var i = 0; i < s.length; i++) {
      var ch = s.charAt(i);
      if (ch === " " || ch === "\t" || ch === "\n" || ch === "\r" || ch === " " || ch === "\u000B") {
        if (tok) { res += token3(tok, m); tok = ""; }
        res += ch;
      } else tok += ch;
    }
    if (tok) res += token3(tok, m);
    return res;
  }
  return { ogir: function (s) { return ogir3(s, 1); }, ogir3: ogir3 };
})();

function $(id){return document.getElementById(id);}
function holat(t){$("holat").innerText=t;}
var MAQSAD=1, NOM={1:"Lotin 2026",2:"Lotin 1995",3:"Kirill"};
function ogirish(){ $("chiq").value = OZB.ogir3($("kir").value, MAQSAD); $("chiqnom").innerText = NOM[MAQSAD]; }
function tanla(m){ MAQSAD=m; for(var i=1;i<=3;i++){ $("b"+i).className = (i===m) ? "tanlangan" : ""; } ogirish(); }
function kechiktir(){ window.setTimeout(ogirish, 30); }
function buferdan(m){
  tanla(m);
  var t = "";
  try { t = window.clipboardData.getData("Text") || ""; } catch(e) {}
  if (!t) { holat("Buferda matn yo'q. Avval matnni belgilab Ctrl+C bosing."); return; }
  var r = OZB.ogir3(t, MAQSAD);
  $("kir").value = t; $("chiq").value = r;
  try { window.clipboardData.setData("Text", r); holat("Tayyor! Endi kerakli joyga Ctrl+V bilan qo'ying."); }
  catch(e) { holat("O'girildi. O'ng tomondagi matnni nusxalang."); }
}
function nusxa(){
  try { window.clipboardData.setData("Text", $("chiq").value); holat("Nusxalandi. Ctrl+V bilan qo'ying."); }
  catch(e) { $("chiq").select(); holat("Matn belgilandi - Ctrl+C bosing."); }
}
function tozala(){ $("kir").value=""; $("chiq").value=""; holat(""); $("kir").focus(); }
window.onload=function(){ try{ window.resizeTo(1000,720); window.moveTo(60,30);}catch(e){} $("kir").focus(); };
</script>
</head>
<body>
<h1>Özbek yozuvlari — konverter</h1>
<p class="sub">Istalgan o'zbekcha matnni Lotin 2026, Lotin 1995 yoki Kirill yozuviga o'giradi. Internet kerak emas.</p>
<div class="row">
<div class="col"><label for="kir">Matn (istalgan yozuvda)</label>
<textarea id="kir" onkeyup="kechiktir()" onpaste="kechiktir()" oninput="kechiktir()" onpropertychange="kechiktir()"></textarea></div>
<div class="col2"><label for="chiq">Natija: <span id="chiqnom">Lotin 2026</span></label>
<textarea id="chiq" readonly="readonly"></textarea></div>
</div>
<div class="btns">
<span style="font-weight:bold;margin-right:8px">Buferdagi matnni o'girish:</span>
<button id="b1" class="tanlangan" onclick="buferdan(1)">Lotin 2026</button>
<button id="b2" onclick="buferdan(2)">Lotin 1995</button>
<button id="b3" onclick="buferdan(3)">Kirill</button>
<span style="display:inline-block;width:18px"></span>
<button onclick="nusxa()">Natijani nusxalash</button>
<button onclick="tozala()">Tozalash</button>
</div>
<div id="holat"></div>
<div class="yord">
<b>Eng tez usul (Word, Excel, Telegram — hammasida):</b> matnni belgilang → <b>Ctrl+C</b> → shu oynada kerakli yozuv tugmasi (<b>Lotin 2026</b>, <b>Lotin 1995</b> yoki <b>Kirill</b>) → o'sha joyga qaytib <b>Ctrl+V</b>.<br>
<b>Kitobcha (Word):</b> Разметка страницы → Поля → Настраиваемые поля → «Несколько страниц»: <b>Брошюра</b> → OK. Chop etishda: <b>Печать вручную на обеих сторонах</b>.
</div>
</body>
</html>
